<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stack_item_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/stack_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">
        <TextView
            android:id="@+id/stack_item_title"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/slot_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/slot_1_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/slot_1_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/slot_1_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="7.5sp"
                    android:textColor="#AAAAAA"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/slot_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/slot_2_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/slot_2_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/slot_2_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="7.5sp"
                    android:textColor="#AAAAAA"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/slot_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/slot_3_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/slot_3_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/slot_3_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="7.5sp"
                    android:textColor="#AAAAAA"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/slot_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/slot_4_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/slot_4_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/slot_4_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="7.5sp"
                    android:textColor="#AAAAAA"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
