<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 12-Theme Glass Card Surface Background -->
    <ImageView
        android:id="@+id/stack_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- ViewFlipper Container -->
    <ViewFlipper
        android:id="@+id/stack_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Invisible Left & Right Edge Touch Targets for Quick 1-Tap Flipping -->
    <ImageView
        android:id="@+id/stack_edge_prev"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/stack_edge_next"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:contentDescription="@null" />

    <!-- Tactical Bottom Navigation Strip with Prev/Next and Page Counter -->
    <LinearLayout
        android:id="@+id/stack_nav_strip"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/btn_stack_prev"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="◀"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/stack_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:text="1 / 3"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:textColor="#CCCCCC" />

        <TextView
            android:id="@+id/btn_stack_next"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▶"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
