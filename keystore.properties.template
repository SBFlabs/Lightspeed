# ============================================================
# Lightspeed Release Signing Configuration Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to: keystore.properties (same directory)
#   2. Fill in your production keystore details
#   3. NEVER commit keystore.properties to git (it is gitignored)
#
# To generate a new keystore:
#   keytool -genkey -v -keystore lightspeed-release.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -alias lightspeed
# ============================================================

storeFile=../lightspeed-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=lightspeed
keyPassword=YOUR_KEY_PASSWORD
